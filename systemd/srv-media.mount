[Unit]
Description=Mount External Media Drive to /srv/media
After=network.target

[Mount]
# UUID is substituted from MEDIA_UUID in .env at deploy time by tasks/systemd.py.
# Find yours with: blkid /dev/sdX   (e.g. blkid /dev/sda1)
What=/dev/disk/by-uuid/${MEDIA_UUID}
Where=/srv/media
Type=exfat
# uid/gid must match the user that runs the containers (check with: id)
Options=defaults,uid=1000,gid=1000,nofail,dmask=000,fmask=000,context="system_u:object_r:container_file_t:s0"

[Install]
WantedBy=multi-user.target
