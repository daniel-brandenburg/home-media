# ─── home-media .env ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in every value before running deploy.sh or
# setup-arr.sh.  The .env file is gitignored and never committed.
#
# To get started:
#   cp .env.example .env
#   $EDITOR .env

# ─── Remote server ────────────────────────────────────────────────────────────
# SSH target for deploy.sh and setup-arr.sh (user@hostname or user@ip)
REMOTE="user@mediaserver"

# LAN IP of the server — used for Dashy tile links
SERVER_IP="192.168.1.100"

# Absolute path on the server where config files live
REMOTE_DIR="/srv/containers"

# ─── Host user ────────────────────────────────────────────────────────────────
# UID and GID of the user that owns /srv/containers and /srv/media on the server.
# Find these with: id
PUID=1000
PGID=1000

# ─── Timezone ─────────────────────────────────────────────────────────────────
# Used by FlareSolverr and Audiobookshelf.
# Examples: America/New_York, Europe/London, Australia/Sydney
TZ="Etc/UTC"

# ─── External media drive ─────────────────────────────────────────────────────
# UUID of the exFAT drive mounted at /srv/media.
# Find it with: blkid /dev/sdX  (replace sdX with your drive, e.g. sda1)
MEDIA_UUID="XXXX-XXXX"

# ─── qBittorrent ──────────────────────────────────────────────────────────────
QBIT_USER="your-username"
# Choose a strong password — this is set on first run by setup-arr.sh
QBIT_PASS="your-strong-password"

# ─── Postgres (Bitmagnet) ─────────────────────────────────────────────────────
# Password for the internal Bitmagnet Postgres database.
# Only reachable on the internal container network, but use something strong.
POSTGRES_PASSWORD="your-strong-password"

# ─── API keys ─────────────────────────────────────────────────────────────────
# These are auto-generated by each app on first start.
# Steps:
#   1. Deploy and start the stack.
#   2. Open each app's Settings -> General and copy the API key here.
#   3. Run setup-arr.sh.
SONARR_API=""
RADARR_API=""
PROWLARR_API=""
LISTENARR_API=""
