[Unit]
Description=Prowlarr indexer manager
After=network-online.target media_net-network.service
Requires=media_net-network.service

[Container]
Image=lscr.io/linuxserver/prowlarr:latest
ContainerName=prowlarr
EnvironmentFile=/srv/containers/.env
PublishPort=9696:9696
Volume=/srv/containers/prowlarr:/config:Z
Network=media_net.network

[Service]
Restart=always

[Install]
WantedBy=default.target
