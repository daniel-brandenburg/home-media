[Unit]
Description=Jellyfin media server
After=network-online.target media_net-network.service srv-media.mount
Requires=media_net-network.service srv-media.mount

[Container]
Image=lscr.io/linuxserver/jellyfin:latest
ContainerName=jellyfin
EnvironmentFile=/srv/containers/.env
PublishPort=8096:8096
Volume=/srv/containers/jellyfin:/config:Z
Volume=/srv/media:/data
# NO :Z on /data (exFAT drive does not support SELinux labels)
Network=media_net.network

[Service]
Restart=always

[Install]
WantedBy=default.target
