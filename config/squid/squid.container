[Unit]
Description=Egress proxy for agent devcontainers
After=network-online.target

[Container]
Image=docker.io/ubuntu/squid:6.6-24.04_edge
ContainerName=squid
# Devcontainers join this bridge network (by name, e.g. --network=systemd-devcontainer-egress)
# and reach Squid at http://squid:3128 via aardvark-dns, rather than sharing Squid's network
# namespace via --network=container:squid. The netns-join approach broke once devpod started
# requesting rootless Podman's --userns=keep-id for the devcontainer (to align bind-mount
# ownership): keep-id containers can't mount /sys when joining another container's network
# namespace on Podman 5.8.3 (runc: "error mounting sysfs ... operation not permitted"),
# regardless of the target container's own userns mode. A shared bridge network sidesteps the
# bug entirely since neither side needs to join the other's netns.
Network=devcontainer-egress.network
# No :Z here (unlike the rootful quadlets in quadlets/, which all use it) —
# relabeling a bind mount to container_file_t requires CAP_MAC_ADMIN, which
# root has but the rootless "db" user running this quadlet does not. With
# :Z, `podman run` fails outright: lsetxattr(...) /srv/containers/squid/squid.conf:
# operation not permitted. squid.conf isn't shared with any other container,
# so skipping the relabel (and leaving its existing context alone) is fine.
Volume=/srv/containers/squid/squid.conf:/etc/squid/squid.conf:ro
# No Exec= override: the image's default Cmd (-f /etc/squid/squid.conf -NYC)
# is already correct, and the entrypoint prepends the squid binary, so an
# Exec= of "squid ..." would end up running "squid squid ...".

[Service]
Restart=always
# First start pulls the image into the rootless store; give it longer than
# systemd's 90s default or the start is killed mid-pull.
TimeoutStartSec=300

[Install]
WantedBy=default.target
