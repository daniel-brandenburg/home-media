{
  "name": "alarmclock agent sandbox",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:Etc/UTC}"
    }
  },
  "runArgs": [
    "--security-opt=label=disable"
  ],
  "remoteUser": "ubuntu",
  "mounts": [
    "source=agent-claude-config,target=/home/ubuntu/.claude,type=volume",
    "source=agent-kimi-config,target=/home/ubuntu/.kimi-code,type=volume",
    "source=agent-gh-config,target=/home/ubuntu/.config/gh,type=volume",
    "source=/srv/containers/claude-config,target=/opt/claude-config,type=bind,readonly"
  ],
  "containerEnv": {
    "CI": "true"
  },
  "postCreateCommand": "bash /opt/claude-config/setup.sh",
  "postStartCommand": "sudo /usr/sbin/service cron start",
  "waitFor": "postStartCommand"
}
